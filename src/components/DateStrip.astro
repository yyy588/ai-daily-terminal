---
/**
 * 日期月历（贡献图式，单月宽度）：全部档案月纵向堆叠（最新在上），
 * 月历头部 [← 月份 →] 锚点翻月——零 JS，点箭头滚动定位到目标月。
 * 深浅 4 档编码新闻量；无档案日灰格不可点；详情页当前日描边。
 */
import { internalHref } from '../lib/href';
import { buildCalendars, intensityClass } from '../lib/build-calendar';
import type { DailyDigest } from '../lib/types';

interface Props {
  readonly digests: readonly DailyDigest[];
  /** 当前选中日（详情页传该页日期） */
  readonly currentDate?: string;
}

const { digests, currentDate } = Astro.props;
const calendars = buildCalendars(digests, 99); // 全部档案月都渲染（纵向堆叠）
const latestDate = digests[0]?.date;

const WEEKDAYS = ['一', '二', '三', '四', '五', '六', '日'];

/**
 * 箭头目标：相邻档案月（buildCalendars 已倒序——索引 0 = 最新月）。
 * →（右箭头）= 时间上更近的月（堆叠上方，索引更小）；← = 更早的月（下方，索引更大）。
 */
const monthIndex = new Map(calendars.map((c, i) => [c.yearMonth, i]));
const newerMonthOf = (ym: string): string | null => {
  const i = monthIndex.get(ym)!;
  return i > 0 ? calendars[i - 1].yearMonth : null;
};
const olderMonthOf = (ym: string): string | null => {
  const i = monthIndex.get(ym)!;
  return i < calendars.length - 1 ? calendars[i + 1].yearMonth : null;
};
---

<nav class="date-cal mono" aria-label="按日期查看要闻">
  {
    calendars.map((cal) => {
      const older = olderMonthOf(cal.yearMonth); // 时间更早的月（堆叠下方）
      const newer = newerMonthOf(cal.yearMonth); // 更近的月（上方）
      return (
        <div class="date-cal__month" id={`cal-${cal.yearMonth}`}>
          <p class="date-cal__head">
            {newer !== null ? (
              <a class="date-cal__nav" href={`#cal-${newer}`} aria-label={`更新月份 ${newer}`}>
                ←
              </a>
            ) : (
              <span class="date-cal__nav date-cal__nav--pad" aria-hidden="true">←</span>
            )}
            <span class="date-cal__ym">{cal.yearMonth.replace('-', ' / ')}</span>
            {older !== null ? (
              <a class="date-cal__nav" href={`#cal-${older}`} aria-label={`更早月份 ${older}`}>
                →
              </a>
            ) : (
              <span class="date-cal__nav date-cal__nav--pad" aria-hidden="true">→</span>
            )}
          </p>
          <div class="date-cal__grid" role="grid">
            {WEEKDAYS.map((w) => (
              <span class="date-cal__weekday" role="columnheader">{w}</span>
            ))}
            {cal.cells.map((cell) => {
              if (!cell.hasArchive || cell.date === null) {
                return (
                  <span
                    class={`date-cal__cell date-cal__cell--${cell.day === null ? 'pad' : `off`}`}
                    role="gridcell"
                  />
                );
              }
              const isCurrent = cell.date === currentDate;
              const isLatest = cell.date === latestDate;
              return (
                <a
                  class={`date-cal__cell date-cal__cell--day ${intensityClass(cell.count)}`}
                  href={internalHref(`/news/${cell.date}/`)}
                  aria-current={isCurrent ? 'page' : undefined}
                  aria-label={`${cell.date} 日报 ${cell.count} 条${isLatest ? '（今日）' : ''}`}
                  title={`${cell.date} · ${cell.count} 条`}
                >
                  {isLatest && <i class="date-cal__today">今</i>}
                  {cell.day}
                </a>
              );
            })}
          </div>
        </div>
      );
    })
  }
</nav>

<style>
  .date-cal {
    display: flex;
    flex-direction: column;
    gap: var(--space-m);
    padding: var(--space-s) 0 var(--space-m);
    max-width: 17rem; /* 单月宽度 */
  }

  .date-cal__head {
    margin: 0 0 var(--space-xs);
    display: grid;
    grid-template-columns: 1.8rem 1fr 1.8rem;
    align-items: center;
  }

  .date-cal__nav {
    font-size: 0.9rem;
    color: var(--color-text-dim);
    text-align: center;
    text-decoration: none;
    padding: 0.1em 0.3em;
    border-radius: 2px;
    transition: color var(--duration-fast) ease, background var(--duration-fast) ease;
  }

  a.date-cal__nav:hover {
    color: var(--color-primary);
    background: var(--color-primary-soft);
  }

  .date-cal__nav--pad {
    visibility: hidden; /* 占位保持三段对齐，但不可见不可点 */
  }

  .date-cal__ym {
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    font-weight: 600;
    text-align: center;
  }

  .date-cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1.9rem);
    gap: 3px;
  }

  .date-cal__weekday {
    font-size: 0.58rem;
    color: var(--color-text-faint);
    text-align: center;
    line-height: 1.4;
  }

  .date-cal__cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    font-size: 0.68rem;
    border-radius: 2px;
    text-decoration: none;
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  /* 无档案/占位格：不可点 */
  .date-cal__cell--pad {
    background: transparent;
  }

  .date-cal__cell--off {
    background: var(--color-surface-raised);
    color: var(--color-text-faint);
  }

  /* 有档案日：4 档深浅（贡献图式） */
  .date-cal__cell--day {
    font-weight: 500;
    color: var(--color-text);
  }

  .date-cal__cell--day.lv1 {
    background: color-mix(in srgb, var(--color-primary) 22%, var(--color-surface));
  }

  .date-cal__cell--day.lv2 {
    background: color-mix(in srgb, var(--color-primary) 45%, var(--color-surface));
  }

  .date-cal__cell--day.lv3 {
    background: var(--color-primary);
    color: var(--color-surface);
    font-weight: 700;
  }

  .date-cal__cell--day:hover {
    transform: scale(1.12);
    box-shadow: 0 0 0 1px var(--color-primary);
  }

  .date-cal__cell--day[aria-current='page'] {
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .date-cal__today {
    position: absolute;
    top: -0.4em;
    right: -0.2em;
    font-style: normal;
    font-size: 0.55rem;
    color: var(--color-accent);
    font-weight: 700;
    line-height: 1;
  }
</style>
