---
/**
 * 日期月历下拉（GitHub 贡献图式，收纳在 <details> 原生折叠里）：
 * 摘要行常驻（含月份范围提示），展开见月历——零 JS 真"下拉"。
 * 档案日按新闻量 4 档深浅，点击进日报详情页；详情页默认展开（当前日直接可见）。
 */
import { internalHref } from '../lib/href';
import { buildCalendars, intensityClass } from '../lib/build-calendar';
import type { DailyDigest } from '../lib/types';

interface Props {
  readonly digests: readonly DailyDigest[];
  /** 当前选中日（详情页传该页日期；传入时 <details> 默认展开） */
  readonly currentDate?: string;
  /** 最多展示几个月历 */
  readonly maxMonths?: number;
}

const { digests, currentDate, maxMonths = 2 } = Astro.props;
const calendars = buildCalendars(digests, maxMonths);
const latestDate = digests[0]?.date;
const monthCount = calendars.length;
const rangeHint = monthCount > 0
  ? `${calendars[monthCount - 1].yearMonth.replace('-', '.')} – ${calendars[0].yearMonth.replace('-', '.')}`
  : '';

const WEEKDAYS = ['一', '二', '三', '四', '五', '六', '日'];
---

<details class="date-cal-drop" open={currentDate !== undefined}>
  <summary class="mono">
    📅 按日期查看 <span class="date-cal-drop__meta">{monthCount} 个月（{rangeHint}）</span>
    <span class="date-cal-drop__hint">点击展开/收起</span>
  </summary>

  <nav class="date-cal mono" aria-label="按日期查看要闻">
  {
    calendars.map((cal) => (
      <div class="date-cal__month">
        <p class="date-cal__ym">
          {cal.yearMonth.replace('-', ' / ')}
        </p>
        <div class="date-cal__grid" role="grid">
          {WEEKDAYS.map((w) => (
            <span class="date-cal__weekday" role="columnheader">{w}</span>
          ))}
          {cal.cells.map((cell) => {
            if (!cell.hasArchive || cell.date === null) {
              return (
                <span
                  class={`date-cal__cell date-cal__cell--${cell.day === null ? 'pad' : `off ${intensityClass(0)}`}`}
                  role="gridcell"
                  aria-label={cell.day !== null ? `${cell.date ?? ''} 无档案` : undefined}
                />
              );
            }
            const isCurrent = cell.date === currentDate;
            const isLatest = cell.date === latestDate;
            return (
              <a
                class={`date-cal__cell date-cal__cell--day ${intensityClass(cell.count)}`}
                href={internalHref(`/news/${cell.date}/`)}
                aria-current={isCurrent ? 'page' : undefined}
                aria-label={`${cell.date} 日报 ${cell.count} 条${isLatest ? '（今日）' : ''}`}
                title={`${cell.date} · ${cell.count} 条`}
              >
                {isLatest && <i class="date-cal__today">今</i>}
                {cell.day}
              </a>
            );
          })}
        </div>
      </div>
    ))
  }
  </nav>
</details>

<style>
  .date-cal-drop {
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-surface);
    margin: var(--space-s) 0;
  }

  .date-cal-drop summary {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    padding: 0.5rem var(--space-m);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    cursor: pointer;
    list-style: none; /* 自绘指示 */
    user-select: none;
    transition: color var(--duration-fast) ease;
  }

  .date-cal-drop summary::-webkit-details-marker {
    display: none;
  }

  .date-cal-drop summary:hover {
    color: var(--color-primary);
  }

  .date-cal-drop__meta {
    color: var(--color-text-faint);
    font-size: 0.68rem;
  }

  .date-cal-drop__hint {
    margin-left: auto;
    font-size: 0.62rem;
    color: var(--color-text-faint);
  }

  /* 展开时指示箭头旋转 */
  .date-cal-drop summary::before {
    content: '▸';
    color: var(--color-primary);
    transition: transform var(--duration-fast) ease;
  }

  .date-cal-drop[open] summary::before {
    transform: rotate(90deg);
  }

  .date-cal-drop[open] summary {
    border-bottom: 1px solid var(--color-border);
  }

  .date-cal {
    padding: var(--space-m);
  }

  .date-cal {
    display: flex;
    gap: var(--space-l);
    flex-wrap: wrap;
  }

  .date-cal__month {
    min-width: 0;
  }

  .date-cal__ym {
    margin: 0 0 var(--space-xs);
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--color-primary);
    font-weight: 600;
  }

  .date-cal__grid {
    display: grid;
    grid-template-columns: repeat(7, 1.8rem);
    gap: 3px;
  }

  .date-cal__weekday {
    font-size: 0.58rem;
    color: var(--color-text-faint);
    text-align: center;
    line-height: 1.4;
  }

  .date-cal__cell {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.8rem;
    height: 1.8rem;
    font-size: 0.68rem;
    border-radius: 2px;
    text-decoration: none;
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease;
  }

  /* 无档案/占位格：不可点 */
  .date-cal__cell--pad {
    background: transparent;
  }

  .date-cal__cell--off {
    background: var(--color-surface-raised);
    color: var(--color-text-faint);
  }

  /* 有档案日：4 档深浅（GitHub 贡献图式） */
  .date-cal__cell--day {
    font-weight: 500;
    color: var(--color-text);
  }

  .date-cal__cell--day.lv1 {
    background: color-mix(in srgb, var(--color-primary) 22%, var(--color-surface));
  }

  .date-cal__cell--day.lv2 {
    background: color-mix(in srgb, var(--color-primary) 45%, var(--color-surface));
  }

  .date-cal__cell--day.lv3 {
    background: var(--color-primary);
    color: var(--color-surface);
    font-weight: 700;
  }

  .date-cal__cell--day:hover {
    transform: scale(1.12);
    box-shadow: 0 0 0 1px var(--color-primary);
  }

  .date-cal__cell--day[aria-current='page'] {
    box-shadow: 0 0 0 2px var(--color-accent);
  }

  .date-cal__today {
    position: absolute;
    top: -0.4em;
    right: -0.2em;
    font-style: normal;
    font-size: 0.55rem;
    color: var(--color-accent);
    font-weight: 700;
    line-height: 1;
  }

  @media (max-width: 480px) {
    .date-cal {
      gap: var(--space-m);
    }

    .date-cal__grid {
      grid-template-columns: repeat(7, 1.9rem);
    }

    .date-cal__cell {
      width: 1.9rem;
      height: 1.9rem;
    }
  }
</style>
