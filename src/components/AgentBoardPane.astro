---
/**
 * Agent 能力榜面板（arena.astro 与 [dimension].astro 共用，与 ArenaBoardPane 对称）。
 * 列：净改进率（主指标）±CI / 每任务成本。样式走 global.css 的 arena 共享区段。
 */
import type { ArenaBoard } from '../lib/arena';

interface Props {
  readonly board: ArenaBoard | undefined;
  readonly maxRows?: number;
}

const { board, maxRows = 30 } = Astro.props;
---

{
  board && board.rows.length > 0 ? (
    <div class="board__pane">
      <h2 class="board__title mono">
        Agent · 能力
        <span class="board__meta">{board.rows.length} 模型 · 多指标</span>
      </h2>
      <ol class="board__list">
        <li class="wrow wrow--head mono" aria-hidden="true">
          <span class="wrow__rank">#</span>
          <span class="wrow__model">模型</span>
          <span class="wrow__score">净改进率</span>
          <span class="wrow__price">每任务成本 $/次</span>
        </li>
        {board.rows.slice(0, maxRows).map((row) => (
          <li class="wrow">
            <span class="wrow__rank mono">{String(row.rank).padStart(2, '0')}</span>
            <span class="wrow__model">
              <span class="wrow__name">{row.modelName}</span>
              <span class="board__badges">
                {row.isOpenSource ? <span class="chip chip--open">开源</span> : <span class="chip">闭源</span>}
                <span class="chip chip--org">{row.organization}</span>
              </span>
            </span>
            <span class="wrow__score mono">
              {row.netImprovement !== undefined ? `${row.netImprovement.toFixed(1)}%` : '--'}
              {row.netImprovementCi && <span class="wrow__ci">{row.netImprovementCi}</span>}
            </span>
            <span class="wrow__price mono" title="每完成一个任务的平均成本（美元/次，P50 中位数）">{row.costPerTask ?? '--'}</span>
          </li>
        ))}
      </ol>
    </div>
  ) : (
    <div class="doc-card">
      <p class="doc-card__summary">// Agent 榜暂无数据，等待抓取或本地刷新。</p>
    </div>
  )
}
