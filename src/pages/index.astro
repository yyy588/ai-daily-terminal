---
import BaseLayout from '../layouts/BaseLayout.astro';
import DateStrip from '../components/DateStrip.astro';
import { loadSiteData, loadReposData, loadArenaData, SOURCE_NAMES } from '../lib/site';
import { internalHref } from '../lib/href';
import { sortByScore } from '../lib/scoring';

const data = loadSiteData();
const latest = data.digests[0];

// 今日要闻：多源加权混排（权重×时间衰减+共报加成），只作用于首页；详情页保持时间序
const todayEntries = latest ? latest.entries : [];
const topEntries = todayEntries.length
  ? sortByScore(todayEntries, Date.now()).slice(0, 10)
  : [];

// 周热榜：近 7 天日历窗口 × 48h 半衰期（隔夜大稿不消失，7 天前的衰减到 ~5%）
const WEEK_WINDOW_MS = 7 * 86_400_000;
const WEEK_HALF_LIFE_H = 48;
const now = Date.now();
const weekEntries = data.digests
  .flatMap((g) => g.entries)
  .filter((e) => now - Date.parse(e.pubDate) <= WEEK_WINDOW_MS);
const weeklyTop = weekEntries.length
  ? sortByScore(weekEntries, now, WEEK_HALF_LIFE_H).slice(0, 10)
  : [];

/** 相对日期标签：今天 / 昨天 / N天前（按北京日历日算，不足 24h 也可能跨"昨天"） */
function relativeAge(pubDate: string): string {
  const days = daysAgoBJ(Date.parse(pubDate), now);
  if (days <= 0) return '今天';
  if (days === 1) return '昨天';
  return `${days}天前`;
}

/** 北京日历日差 */
function daysAgoBJ(ts: number, refNow: number): number {
  return Math.floor((dayStartBJ(refNow) - dayStartBJ(ts)) / 86_400_000);
}

/** 北京日期串 YYYY-MM-DD（供年龄标签链接该日日报） */
function beijingDate(ts: number): string {
  return new Date(ts + 8 * 3600_000).toISOString().slice(0, 10);
}

function dayStartBJ(ts: number): number {
  return Date.parse(`${beijingDate(ts)}T00:00:00+08:00`);
}

const reposData = loadReposData();
const topRepos = reposData.repos.slice(0, 5);
const arenaData = loadArenaData();
const arenaTop = arenaData.boards.map((b) => ({ title: b.title, snapshot: b.fetchedAt.slice(0, 10), top3: b.rows.slice(0, 3) }));

function timeOf(pubDate: string): string {
  const ts = Date.parse(pubDate);
  return Number.isNaN(ts)
    ? '--:--'
    : new Date(ts + 8 * 3600_000).toISOString().slice(11, 16);
}
---

<BaseLayout title="AI_TERMINAL // 每日要闻">
  <header class="hud-bar" role="status">
    <span class="hud-bar__status">SYSTEM_ONLINE // 神经链路稳定</span>
    <span>LAST_SYNC: {data.generatedAt ? new Date(data.generatedAt).toISOString().slice(0, 16).replace('T', ' ') + 'Z' : 'STANDBY'}</span>
    <span>ARCHIVE_DAYS: {data.digests.length}</span>
    <span>SIGNAL: {latest ? `${latest.entries.length} ITEMS` : 'NO_DATA'}</span>
  </header>

  <DateStrip digests={data.digests} />

  <section aria-labelledby="weekly-heading">
    <h1 class="section-title" id="weekly-heading">周热榜 // 七日最热</h1>
    {
      weeklyTop.length === 0 ? (
        <div class="doc-card">
          <p class="doc-card__summary">// 档案不足一周，热榜等待积累。</p>
        </div>
      ) : (
        <ol class="weekly-list">
          {weeklyTop.map((entry, i) => (
            <li class="doc-card weekly__item">
              <article>
                <div class="doc-card__meta">
                  <span class="weekly__rank mono">{String(i + 1).padStart(2, '0')}</span>
                  <span class="weekly__age">
                    <a href={internalHref(`/news/${beijingDate(Date.parse(entry.pubDate))}/`)}>{relativeAge(entry.pubDate)}</a>
                  </span>
                  {entry.sources.map((s) => (
                    <span class="source-chip">{SOURCE_NAMES[s] ?? s}</span>
                  ))}
                  <span class="weekly__score mono" title="热度分：来源权重×时间衰减+共报加成">
                    {entry.score.toFixed(2)}
                  </span>
                </div>
                <h2 class="doc-card__title">
                  <a href={entry.link} target="_blank" rel="noopener noreferrer">{entry.title}</a>
                </h2>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  <section aria-labelledby="today-heading">
    <h1 class="section-title" id="today-heading">
      {latest ? `今日要闻 // ${latest.date}` : '待机模式 // 等待首次同步'}
    </h1>

    {
      topEntries.length === 0 ? (
        <div class="doc-card">
          <p class="doc-card__summary">
            // 无数据。运行 <code class="mono">npm run fetch-news</code> 触发首次抓取，或等待 GitHub Actions 定时任务。
          </p>
        </div>
      ) : (
        <ol class="top-list">
          {topEntries.map((entry, i) => (
            <li class="doc-card top-list__item">
              <article>
                <div class="doc-card__meta">
                  <span class="top-list__index mono">{String(i + 1).padStart(2, '0')}</span>
                  <span>{timeOf(entry.pubDate)}</span>
                  {entry.sources.map((s) => (
                    <span class="source-chip">{SOURCE_NAMES[s] ?? s}</span>
                  ))}
                </div>
                <h2 class="doc-card__title">
                  <a href={entry.link} target="_blank" rel="noopener noreferrer">
                    {entry.title}
                  </a>
                </h2>
                {entry.summary && <p class="doc-card__summary">{entry.summary}</p>}
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </section>

  {latest && latest.entries.length > 10 && (
    <p class="more-link mono">
      <a href={internalHref(`/news/${latest.date}/`)}>[ 查看当日全部 {latest.entries.length} 条 → ]</a>
    </p>
  )}

  <section aria-labelledby="radar-heading">
    <h2 class="section-title" id="radar-heading">新锐雷达 // GitHub AI 开源项目</h2>
    {topRepos.length === 0 ? (
      <div class="doc-card">
        <p class="doc-card__summary">// 雷达待机。等待 <code class="mono">fetch-repos</code> 首次扫描。</p>
      </div>
    ) : (
      <ol class="repo-brief">
        {topRepos.map((repo, i) => (
          <li class="doc-card repo-brief__item">
            <article>
              <div class="doc-card__meta">
                <span class="repo-brief__rank mono">{String(i + 1).padStart(2, '0')}</span>
                <span class="repo-brief__stars mono">★ {repo.stars.toLocaleString('en-US')}</span>
                <span class="source-chip">{repo.language}</span>
              </div>
              <h3 class="doc-card__title">
                <a href={repo.url} target="_blank" rel="noopener noreferrer">{repo.fullName} ↗</a>
              </h3>
              {repo.description && <p class="doc-card__summary">{repo.description}</p>}
            </article>
          </li>
        ))}
      </ol>
    )}
    <p class="more-link mono">
      <a href={internalHref('/repos/')}>[ 完整新锐榜（{reposData.repos.length} 个） → ]</a>
    </p>
  </section>

  {arenaTop.length > 0 && (
    <section aria-labelledby="arena-brief-heading">
      <h2 class="section-title" id="arena-brief-heading">竞技场速览 // 大模型多榜 Top 3</h2>
      <div class="arena-brief">
        {arenaTop.map((board) => (
          <div class="doc-card arena-brief__board">
            <div class="doc-card__meta">
              <span class="doc-card__tag">[ {board.title} ]</span>
              <span>快照 {board.snapshot}</span>
            </div>
            <ol class="arena-brief__list">
              {board.top3.map((row) => (
                <li class="arena-brief__row">
                  <span class="mono arena-brief__rank">{row.rank}</span>
                  <span class="arena-brief__name">{row.modelName}</span>
                  <span class="mono arena-brief__score">
                    {row.netImprovement !== undefined ? `${row.netImprovement.toFixed(1)}%` : row.score}
                  </span>
                </li>
              ))}
            </ol>
          </div>
        ))}
      </div>
      <p class="more-link mono">
        <a href={internalHref('/arena/')}>[ 完整双榜对照（Top 20） → ]</a>
      </p>
    </section>
  )}

  <section aria-labelledby="subscribe-heading">
    <h2 class="section-title" id="subscribe-heading">订阅 // RSS 输出</h2>
    <div class="doc-card rss-card">
      <p class="doc-card__summary">
        // 每日一条汇总（当日 Top 5 标题）。复制下面的地址，粘贴到任意 RSS 阅读器即可追更。
      </p>
      <div class="rss-row mono">
        <code class="rss-addr">https://yyy588.github.io/ai-daily-terminal/rss.xml</code>
        <button type="button" class="rss-copy" data-copy="https://yyy588.github.io/ai-daily-terminal/rss.xml">
          复制
        </button>
      </div>
      <p class="rss-copied mono" hidden>// 已复制 — 去 RSS 阅读器粘贴订阅</p>
      <p class="more-link mono" style="text-align:left; margin-top: var(--space-s);">
        <a href={internalHref('/news/')}>[ 日报流 → ]</a>
        <span>历史日期用顶部月历直达</span>
      </p>
    </div>
  </section>

  <script>
    // 全站唯一小脚本：RSS 地址一键复制（clipboard API + 老浏览器 execCommand 降级）
    document.querySelectorAll<HTMLButtonElement>('.rss-copy').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy ?? '';
        let ok = false;
        try {
          await navigator.clipboard.writeText(text);
          ok = true;
        } catch {
          const ta = document.createElement('textarea');
          ta.value = text;
          document.body.appendChild(ta);
          ta.select();
          ok = document.execCommand('copy');
          ta.remove();
        }
        if (ok) {
          const tip = document.querySelector('.rss-copied');
          if (tip !== null) {
            tip.hidden = false;
            setTimeout(() => {
              tip.hidden = true;
            }, 2500);
          }
          btn.textContent = '已复制 ✓';
          setTimeout(() => {
            btn.textContent = '复制';
          }, 2500);
        }
      });
    });
  </script>
</BaseLayout>

<style>
  .rss-row {
    display: flex;
    align-items: center;
    gap: var(--space-s);
    margin-top: var(--space-s);
    flex-wrap: wrap;
  }

  .rss-addr {
    flex: 1 1 auto;
    min-width: 0;
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--color-border-active);
    border-radius: 2px;
    background: var(--color-surface-raised);
    font-size: 0.72rem;
    color: var(--color-primary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .rss-copy {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    padding: 0.35rem 0.9rem;
    border: 1px solid var(--color-primary-dim);
    border-radius: 2px;
    background: var(--color-primary-soft);
    color: var(--color-primary);
    cursor: pointer;
    transition: background var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .rss-copy:hover {
    background: var(--color-primary);
    color: var(--color-surface);
  }

  .rss-copied {
    margin: var(--space-xs) 0 0;
    font-size: 0.68rem;
    color: var(--color-primary);
  }

  .weekly-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .weekly__rank {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .weekly__age {
    color: var(--color-text-dim);
    font-size: 0.68rem;
    font-family: var(--font-sans);
  }

  .weekly__age a {
    color: inherit;
  }

  .weekly__score {
    margin-left: auto;
    color: var(--color-primary);
    font-size: 0.7rem;
    font-weight: 600;
  }

  .top-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .top-list__item {
    counter-increment: top;
  }

  .top-list__index {
    color: var(--color-accent);
    font-size: 0.7rem;
  }

  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0 var(--space-m);
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
    font-size: 0.8rem;
  }

  .archive-list a {
    color: var(--color-text-dim);
  }

  .archive-list a:hover {
    color: var(--color-primary);
  }

  .repo-brief {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-s);
  }

  .repo-brief__rank {
    color: var(--color-accent);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .repo-brief__stars {
    color: var(--color-primary);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .arena-brief {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: var(--space-s);
  }

  .arena-brief__list {
    list-style: none;
    margin: var(--space-s) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .arena-brief__row {
    display: grid;
    grid-template-columns: 1.4rem 1fr 3rem;
    align-items: center;
    gap: var(--space-s);
  }

  .arena-brief__rank {
    font-size: 0.7rem;
    color: var(--color-accent);
    font-weight: 700;
  }

  .arena-brief__name {
    font-size: 0.85rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .arena-brief__score {
    font-size: 0.8rem;
    color: var(--color-primary);
    font-weight: 600;
    text-align: right;
  }

  .more-link {
    margin-top: var(--space-m);
    font-size: 0.8rem;
    text-align: right;
  }
</style>
