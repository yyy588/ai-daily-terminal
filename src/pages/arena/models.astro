---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadArenaData } from '../../lib/site';
import { internalHref } from '../../lib/href';

const data = loadArenaData();
const TOP_N = 10;

// 全能力视图：Chat 综合 + Vision + Search + Text-to-Image 四榜网格
const WANTED: readonly { id: string; note: string }[] = [
  { id: 'chat', note: '对话 · 推理 · 综合' },
  { id: 'vision', note: '图像理解 · 多模态' },
  { id: 'search', note: 'AI 搜索 · 事实检索' },
  { id: 't2i', note: '文生图 · 图像生成' },
];

const boards = WANTED.map((w) => {
  const board = data.boards.find((b) => b.id === w.id);
  return board ? { ...w, board } : null;
}).filter((x): x is { id: string; note: string; board: (typeof data.boards)[number] } => x !== null);

const lastSync = data.boards[0]?.fetchedAt.slice(0, 10) ?? 'STANDBY';
---

<BaseLayout
  title="ARENA // 全能力榜 — Chat · Vision · Search · 文生图"
  description="LMArena 全能力视图：综合对话、视觉理解、AI 搜索、文生图四榜对照"
>
  <header class="hud-bar" role="status">
    <span class="hud-bar__status">ALL_MODE // 全域扫描</span>
    <span>BOARDS: {boards.length}</span>
    <span>SNAPSHOT: {lastSync}</span>
    <span>SOURCE: LMArena</span>
  </header>

  <nav class="view-tabs mono" aria-label="榜单视图切换">
    <a href={internalHref('/arena/')}>[ 开发 · 代码+智能体 ]</a>
    <a href={internalHref('/arena/models/')} aria-current="page">[ 模型 · 全能力 ]</a>
    <a href={internalHref('/arena/agent/')}>[ Agent 深度 ]</a>
  </nav>

  <section aria-labelledby="models-heading">
    <h1 class="section-title" id="models-heading">全能力榜 // 四域对照</h1>

    <div class="models-grid">
      {
        boards.map(({ id, note, board }) => (
          <div class="mboard">
            <h2 class="mboard__title mono">
              {board.title}
              <span class="mboard__note">{note}</span>
            </h2>
            <ol class="mboard__list">
              {board.rows.slice(0, TOP_N).map((row) => (
                <li class="mrow">
                  <span class="mrow__rank mono">{String(row.rank).padStart(2, '0')}</span>
                  <span class="mrow__name">{row.modelName}</span>
                  <span class="mrow__score mono">{row.score}</span>
                </li>
              ))}
            </ol>
            <p class="mboard__more mono">
              共 {board.rows.length} 模型 ·{' '}
              <a href={`https://arena.ai/leaderboard/${id === 't2i' ? 'text-to-image' : id === 'chat' ? 'text' : id}/overall`} target="_blank" rel="noopener noreferrer">
                完整榜 ↗
              </a>
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <p class="note mono">
    // 各榜均基于人类盲测投票的 Elo 积分，快照 {lastSync}。
    开发选型（代码/智能体/价格）切 <a href={internalHref('/arena/')}>开发视图</a>。
  </p>
</BaseLayout>

<style>
  .view-tabs {
    display: flex;
    gap: var(--space-m);
    padding: var(--space-m) 0;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }

  .view-tabs a {
    color: var(--color-text-dim);
  }

  .view-tabs a:hover,
  .view-tabs a[aria-current='page'] {
    color: var(--color-primary);
  }

  .models-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: var(--space-l);
  }

  .mboard__title {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-primary);
    margin: 0 0 var(--space-s);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
  }

  .mboard__note {
    font-size: 0.62rem;
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
    font-weight: 400;
  }

  .mboard__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-surface);
    overflow: hidden;
  }

  .mrow {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 3.5rem;
    align-items: center;
    gap: var(--space-s);
    padding: 0.4rem var(--space-m);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-fast) ease;
  }

  .mrow:last-child {
    border-bottom: none;
  }

  .mrow:hover {
    background: var(--color-surface-raised);
  }

  .mboard__list > .mrow:nth-child(-n + 3) .mrow__rank {
    color: var(--color-accent);
    font-weight: 700;
  }

  .mrow__rank {
    font-size: 0.7rem;
    color: var(--color-text-faint);
  }

  .mrow__name {
    font-size: 0.8rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .mrow__score {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: right;
  }

  .mboard__more {
    margin: var(--space-xs) 0 0;
    font-size: 0.62rem;
    color: var(--color-text-faint);
  }

  .note {
    margin-top: var(--space-l);
    font-size: 0.7rem;
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
    line-height: 1.8;
  }
</style>
