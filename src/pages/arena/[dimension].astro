---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArenaBoardPane from '../../components/ArenaBoardPane.astro';
import { loadArenaData } from '../../lib/site';
import { internalHref } from '../../lib/href';
import { ARENA_FILTERS } from '../../lib/arena-filters';

export function getStaticPaths() {
  return ARENA_FILTERS.filter((f) => f.slug !== '').map((f) => ({
    params: { dimension: f.slug },
  }));
}

const { dimension } = Astro.params;
const current = ARENA_FILTERS.find((f) => f.slug === dimension);

if (current === undefined) {
  return Astro.redirect(internalHref('/arena/'));
}

const data = loadArenaData();
const board = data.boards.find((b) => b.id === current.id);
const agent = data.boards.find((b) => b.id === 'agent');
const lastSync = board?.fetchedAt.slice(0, 10) ?? 'STANDBY';
---

<BaseLayout
  title={`ARENA // ${current.label} — 代码能力榜`}
  description={`WebDev ${current.label} 维度代码能力榜 + Agent 能力榜，开发选型`}
>
  <header class="hud-bar" role="status">
    <span class="hud-bar__status">DEV_MODE // 选型工作台</span>
    <span>DIM: {current.label}</span>
    <span>MODELS: {board?.rows.length ?? 0}</span>
    <span>SNAPSHOT: {lastSync}</span>
    <span>SOURCE: LMArena</span>
  </header>

  <section aria-labelledby="dev-heading">
    <h1 class="section-title" id="dev-heading">开发选型 // {current.label}</h1>

    <nav class="filter-tabs mono" aria-label="WebDev 维度筛选">
      {
        ARENA_FILTERS.map((f) => (
          <a
            href={f.slug === '' ? internalHref('/arena/') : internalHref(`/arena/${f.slug}/`)}
            aria-current={f.slug === dimension ? 'page' : undefined}
          >
            {f.label}
          </a>
        ))
      }
    </nav>

    <div class="dev-boards">
      <div class="board">
        <ArenaBoardPane board={board} />
      </div>

      {
        agent && agent.rows.length > 0 && (
          <div class="board">
            <div class="board__pane">
              <h2 class="board__title mono">
                Agent · 能力
                <span class="board__meta">{agent.rows.length} 模型 · 多指标</span>
              </h2>
              <ol class="board__list">
                {agent.rows.slice(0, 20).map((row) => (
                  <li class="wrow">
                    <span class="wrow__rank mono">{String(row.rank).padStart(2, '0')}</span>
                    <span class="wrow__model">
                      <span class="wrow__name">{row.modelName}</span>
                      <span class="board__badges">
                        {row.isOpenSource ? <span class="chip chip--open">开源</span> : <span class="chip">闭源</span>}
                        <span class="chip chip--org">{row.organization}</span>
                      </span>
                    </span>
                    <span class="wrow__score mono">
                      {row.netImprovement !== undefined ? `${row.netImprovement.toFixed(1)}%` : '--'}
                      {row.netImprovementCi && <span class="wrow__ci">{row.netImprovementCi}</span>}
                    </span>
                    <span class="wrow__price mono" title="每任务成本">{row.costPerTask ?? '--'}</span>
                  </li>
                ))}
              </ol>
            </div>
          </div>
        )
      }
    </div>
  </section>

  <p class="note mono">
    // 左列当前维度：{current.label}。右列 = Agent 真实终端多指标，常驻不切换。
  </p>
</BaseLayout>

<style>
  .dev-boards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: var(--space-l);
    align-items: start;
  }

  .filter-tabs {
    display: flex;
    gap: var(--space-s);
    flex-wrap: wrap;
    padding: 0 0 var(--space-s);
    font-size: 0.72rem;
  }

  .filter-tabs a {
    padding: 0.2em 0.6em;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    color: var(--color-text-dim);
    transition: border-color var(--duration-fast) ease, color var(--duration-fast) ease;
  }

  .filter-tabs a:hover {
    border-color: var(--color-border-active);
    color: var(--color-text);
  }

  .filter-tabs a[aria-current='page'] {
    color: var(--color-primary);
    border-color: var(--color-primary-dim);
    background: var(--color-primary-soft);
  }

  .board__title {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin: 0 0 var(--space-s);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
  }

  .board__meta {
    font-size: 0.65rem;
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
  }

  .board__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-surface);
    overflow: hidden;
  }

  .wrow {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) 5rem 5.5rem;
    align-items: center;
    gap: var(--space-s);
    padding: 0.45rem var(--space-m);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-fast) ease;
  }

  .wrow:last-child {
    border-bottom: none;
  }

  .wrow:hover {
    background: var(--color-surface-raised);
  }

  .board__list > .wrow:nth-child(-n + 3) .wrow__rank {
    color: var(--color-accent);
    font-weight: 700;
  }

  .wrow__rank {
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  .wrow__model {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .wrow__name {
    font-size: 0.85rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .board__badges {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0 0.35em;
    border: 1px solid var(--color-border-active);
    border-radius: 2px;
    color: var(--color-text-faint);
    line-height: 1.5;
  }

  .chip--open {
    color: var(--color-primary);
    border-color: var(--color-primary-dim);
  }

  .chip--org {
    color: var(--color-text-dim);
  }

  .wrow__score {
    font-size: 0.9rem;
    font-weight: 600;
    text-align: right;
  }

  .wrow__ci {
    font-size: 0.6rem;
    color: var(--color-text-faint);
    font-weight: 400;
  }

  .wrow__price {
    font-size: 0.65rem;
    color: var(--color-text-faint);
    text-align: right;
  }

  .note {
    margin-top: var(--space-l);
    font-size: 0.7rem;
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
    line-height: 1.8;
  }
</style>
