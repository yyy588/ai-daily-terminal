---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArenaBoardPane from '../../components/ArenaBoardPane.astro';
import AgentBoardPane from '../../components/AgentBoardPane.astro';
import { loadArenaData } from '../../lib/site';
import { internalHref } from '../../lib/href';
import { ARENA_FILTERS } from '../../lib/arena-filters';

export function getStaticPaths() {
  return ARENA_FILTERS.filter((f) => f.slug !== '').map((f) => ({
    params: { dimension: f.slug },
  }));
}

const { dimension } = Astro.params;
const current = ARENA_FILTERS.find((f) => f.slug === dimension);

if (current === undefined) {
  return Astro.redirect(internalHref('/arena/'));
}

const data = loadArenaData();
const board = data.boards.find((b) => b.id === current.id);
const agent = data.boards.find((b) => b.id === 'agent');
const lastSync = board?.fetchedAt.slice(0, 10) ?? 'STANDBY';
---

<BaseLayout
  title={`ARENA // ${current.label} — 代码能力榜`}
  description={`WebDev ${current.label} 维度代码能力榜 + Agent 能力榜，开发选型`}
>
  <header class="hud-bar" role="status">
    <span class="hud-bar__status">DEV_MODE // 选型工作台</span>
    <span>DIM: {current.label}</span>
    <span>MODELS: {board?.rows.length ?? 0}</span>
    <span>SNAPSHOT: {lastSync}</span>
    <span>SOURCE: LMArena</span>
  </header>

  <section aria-labelledby="dev-heading">
    <h1 class="section-title" id="dev-heading">开发选型 // {current.label}</h1>

    <nav class="filter-tabs mono" aria-label="WebDev 维度筛选">
      {
        ARENA_FILTERS.map((f) => (
          <a
            href={f.slug === '' ? internalHref('/arena/') : internalHref(`/arena/${f.slug}/`)}
            aria-current={f.slug === dimension ? 'page' : undefined}
          >
            {f.label}
          </a>
        ))
      }
    </nav>

    <div class="dev-boards">
      <div class="board">
        <ArenaBoardPane board={board} />
      </div>
      <div class="board">
        <AgentBoardPane board={agent} />
      </div>
    </div>
  </section>

  <p class="note mono">
    // 左列当前维度：{current.label}。右列 = Agent 真实终端多指标，常驻不切换。
  </p>
</BaseLayout>
