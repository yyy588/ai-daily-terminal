---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { loadArenaData } from '../../lib/site';
import { internalHref } from '../../lib/href';

const data = loadArenaData();
const MAX_ROWS = 20;

const agentBoard = data.boards.find((b) => b.id === 'agent');
const lastSync = agentBoard?.fetchedAt.slice(0, 10) ?? 'STANDBY';

function fmtSessions(n: number | undefined): string {
  if (n === undefined) return '--';
  return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
}
---

<BaseLayout
  title="ARENA_BOARD // Agent 能力对比"
  description="LMArena Agent 能力榜：净改进率、确认成功率、每任务成本，每日快照"
>
  <header class="hud-bar" role="status">
    <span class="hud-bar__status">AGENT_MODE // 智能体扫描</span>
    <span>MODELS: {agentBoard?.rows.length ?? 0}</span>
    <span>SNAPSHOT: {lastSync}</span>
    <span>METRIC: Net Improvement</span>
  </header>

  <nav class="view-tabs mono" aria-label="榜单视图切换">
    <a href={internalHref('/arena/')}>[ 开发 · 代码+智能体 ]</a>
    <a href={internalHref('/arena/models/')}>[ 模型 · 全能力 ]</a>
    <a href={internalHref('/arena/agent/')} aria-current="page">[ Agent 深度 ]</a>
  </nav>

  <section aria-labelledby="agent-heading">
    <h1 class="section-title" id="agent-heading">
      {agentBoard && agentBoard.rows.length > 0 ? 'Agent 能力对比 // 谁真的能干活' : '待机 // 等待 Agent 榜抓取'}
    </h1>

    {
      !agentBoard || agentBoard.rows.length === 0 ? (
        <div class="doc-card">
          <p class="doc-card__summary">
            // 无数据。本地运行 <code class="mono">ARENA_PROXY=http://127.0.0.1:7897 pnpm fetch-arena</code>。
          </p>
        </div>
      ) : (
        <div class="agent-board">
          <div class="agent-head mono" role="row">
            <span>#</span>
            <span>模型</span>
            <span class="num">净改进</span>
            <span class="num">成功率</span>
            <span class="num">成本/任务</span>
            <span class="num">会话</span>
          </div>
          <ol class="agent-list">
            {agentBoard.rows.slice(0, MAX_ROWS).map((row) => (
              <li class="agent-row">
                <span class="agent-rank mono">{String(row.rank).padStart(2, '0')}</span>
                <span class="agent-model">
                  <span class="agent-name">{row.modelName}</span>
                  <span class="board__badges">
                    {row.isOpenSource ? <span class="chip chip--open">开源</span> : <span class="chip">闭源</span>}
                    <span class="chip chip--org">{row.organization}</span>
                  </span>
                </span>
                <span class="agent-metric mono">
                  {row.netImprovement?.toFixed(2) ?? '--'}%
                  {row.netImprovementCi && <span class="agent-ci"> {row.netImprovementCi}</span>}
                </span>
                <span class="agent-metric mono num">
                  {row.successRate !== undefined ? `${row.successRate.toFixed(2)}%` : '--'}
                </span>
                <span class="agent-metric mono num">{row.costPerTask ?? '--'}</span>
                <span class="agent-sessions mono num" title="会话样本量">{fmtSessions(row.sessions)}</span>
              </li>
            ))}
          </ol>
        </div>
      )
    }
  </section>

  <p class="note mono">
    // Agent 榜基于真实终端会话的多维评估（Net Improvement = 净改进率主指标）。完整指标
    （Steerability/Bash Recovery/Tool Hallucination 等）见
    <a href="https://arena.ai/leaderboard/agent" target="_blank" rel="noopener noreferrer">arena.ai/leaderboard/agent ↗</a>
  </p>
</BaseLayout>

<style>
  .view-tabs {
    display: flex;
    gap: var(--space-m);
    padding: var(--space-m) 0;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }

  .view-tabs a {
    color: var(--color-text-dim);
  }

  .view-tabs a:hover,
  .view-tabs a[aria-current='page'] {
    color: var(--color-primary);
  }

  .agent-board {
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-surface);
    overflow-x: auto;
  }

  .agent-head,
  .agent-row {
    display: grid;
    grid-template-columns: 2.2rem minmax(10rem, 1fr) 6.5rem 5.5rem 5.5rem 4rem;
    align-items: center;
    gap: var(--space-s);
    padding: 0.45rem var(--space-m);
  }

  .agent-head {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: var(--color-text-faint);
    border-bottom: 1px solid var(--color-border);
    text-transform: uppercase;
  }

  .agent-head .num,
  .agent-row .num {
    text-align: right;
  }

  .agent-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .agent-row {
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-fast) ease;
  }

  .agent-row:last-child {
    border-bottom: none;
  }

  .agent-row:hover {
    background: var(--color-surface-raised);
  }

  .agent-row:nth-child(-n + 3) .agent-rank {
    color: var(--color-accent);
    font-weight: 700;
  }

  .agent-rank {
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  .agent-model {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .agent-name {
    font-size: 0.85rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .board__badges {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0 0.35em;
    border: 1px solid var(--color-border-active);
    border-radius: 2px;
    color: var(--color-text-faint);
    line-height: 1.5;
  }

  .chip--open {
    color: var(--color-primary);
    border-color: var(--color-primary-dim);
  }

  .chip--org {
    color: var(--color-text-dim);
  }

  .agent-metric {
    font-size: 0.8rem;
    font-weight: 600;
  }

  .agent-ci {
    font-size: 0.6rem;
    color: var(--color-text-faint);
    font-weight: 400;
  }

  .agent-sessions {
    font-size: 0.7rem;
    color: var(--color-text-faint);
  }

  .note {
    margin-top: var(--space-l);
    font-size: 0.7rem;
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
    line-height: 1.8;
  }

  @media (max-width: 640px) {
    .agent-head {
      display: none;
    }

    .agent-row {
      grid-template-columns: 2rem 1fr auto;
      grid-template-areas:
        'rank model metrics'
        '. model sub';
    }
  }
</style>
