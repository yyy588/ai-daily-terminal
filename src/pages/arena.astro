---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadArenaData } from '../lib/site';
import { internalHref } from '../lib/href';

const data = loadArenaData();
const MAX_ROWS = 20;

// 双榜对照：webdev 模型名 → 排名映射（Chat 榜标注 "↗ #N in WebDev"）
const webdevBoard = data.boards.find((b) => b.id === 'webdev');
const webdevRank = new Map(webdevBoard?.rows.map((r) => [r.modelName, r.rank]) ?? []);

const lastSync = data.boards[0]?.fetchedAt
  ? data.boards[0].fetchedAt.slice(0, 10)
  : 'STANDBY';

function fmtVotes(votes: number): string {
  return votes >= 1000 ? `${(votes / 1000).toFixed(1)}k` : String(votes);
}
---

<BaseLayout
  title="ARENA_BOARD // 大模型竞技场排行"
  description="LMArena 双榜对照：WebDev 代码能力 vs Chat 综合对话，每日快照"
>
  <header class="hud-bar" role="status">
    <span class="hud-bar__status">ARENA_ONLINE // 竞技场扫描</span>
    <span>BOARDS: {data.boards.length}</span>
    <span>SNAPSHOT: {lastSync}</span>
    <span>SOURCE: LMArena (arena.ai)</span>
  </header>

  <section aria-labelledby="arena-heading">
    <h1 class="section-title" id="arena-heading">
      {data.boards.length > 0 ? `大模型竞技场 // 双榜对照` : '竞技场待机 // 等待首次抓取'}
    </h1>

    {
      data.boards.length === 0 ? (
        <div class="doc-card">
          <p class="doc-card__summary">
            // 无数据。CI 运行 <code class="mono">pnpm fetch-arena</code>，或本地
            <code class="mono">ARENA_PROXY=http://127.0.0.1:7897 pnpm fetch-arena</code> 走代理。
          </p>
        </div>
      ) : (
        <div class="boards">
          {data.boards.map((board) => (
            <div class="board">
              <h2 class="board__title mono">
                {board.title}
                <span class="board__meta">{board.rows.length} models · {board.fetchedAt.slice(0, 10)}</span>
              </h2>
              <ol class="board__list">
                {board.rows.slice(0, MAX_ROWS).map((row) => {
                  const crossRank = board.id === 'chat' ? webdevRank.get(row.modelName) : undefined;
                  return (
                    <li class="board__row">
                      <span class="board__rank mono">{String(row.rank).padStart(2, '0')}</span>
                      <span class="board__model">
                        <a
                          href={`https://arena.ai/leaderboard/${board.id === 'chat' ? 'text' : 'code/webdev'}/overall`}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="board__model-link"
                        >
                          {row.modelName}
                        </a>
                        <span class="board__badges">
                          {row.isOpenSource ? (
                            <span class="chip chip--open">开源</span>
                          ) : (
                            <span class="chip">闭源</span>
                          )}
                          <span class="chip chip--org">{row.organization}</span>
                          {crossRank !== undefined && (
                            <span class="chip chip--cross">WebDev #{crossRank}</span>
                          )}
                        </span>
                      </span>
                      <span class="board__score mono">
                        {row.score}
                        {row.ci && <span class="board__ci"> {row.ci}</span>}
                      </span>
                      <span class="board__votes mono" title="投票数">{fmtVotes(row.votes)}</span>
                    </li>
                  );
                })}
              </ol>
            </div>
          ))}
        </div>
      )
    }
  </section>

  <p class="note mono">
    // 数据来源 LMArena（arena.ai），基于人类盲测投票的 Elo 积分。每日自动抓取快照；
    CI 被反爬拦截时沿用最近快照（见 SNAPSHOT 日期）。完整榜与更多维度见
    <a href="https://arena.ai/leaderboard" target="_blank" rel="noopener noreferrer">arena.ai ↗</a>
  </p>
</BaseLayout>

<style>
  .boards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: var(--space-l);
  }

  .board__title {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin: 0 0 var(--space-s);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
  }

  .board__meta {
    font-size: 0.65rem;
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
  }

  .board__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-surface);
    overflow: hidden;
  }

  .board__row {
    display: grid;
    grid-template-columns: 2.2rem 1fr 4.2rem 3rem;
    align-items: center;
    gap: var(--space-s);
    padding: 0.45rem var(--space-m);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-fast) ease;
  }

  .board__row:last-child {
    border-bottom: none;
  }

  .board__row:hover {
    background: var(--color-surface-raised);
  }

  /* 前三名高亮 */
  .board__row:nth-child(-n + 3) .board__rank {
    color: var(--color-accent);
    font-weight: 700;
  }

  .board__rank {
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  .board__model {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .board__model-link {
    color: var(--color-text);
    font-size: 0.85rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .board__model-link:hover {
    color: var(--color-primary);
  }

  .board__badges {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0 0.35em;
    border: 1px solid var(--color-border-active);
    border-radius: 2px;
    color: var(--color-text-faint);
    line-height: 1.5;
  }

  .chip--open {
    color: var(--color-primary);
    border-color: var(--color-primary-dim);
  }

  .chip--org {
    color: var(--color-text-dim);
  }

  .chip--cross {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .board__score {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-text);
    text-align: right;
  }

  .board__ci {
    font-size: 0.6rem;
    color: var(--color-text-faint);
    font-weight: 400;
  }

  .board__votes {
    font-size: 0.7rem;
    color: var(--color-text-faint);
    text-align: right;
  }

  .note {
    margin-top: var(--space-l);
    font-size: 0.7rem;
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
    line-height: 1.8;
  }
</style>
