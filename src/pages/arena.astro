---
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadArenaData } from '../lib/site';
import { internalHref } from '../lib/href';

const data = loadArenaData();
const MAX_ROWS = 20;

// 开发视图 = WebDev（写代码）+ Agent（干活）并排
const webdev = data.boards.find((b) => b.id === 'webdev');
const agent = data.boards.find((b) => b.id === 'agent');

const lastSync = webdev?.fetchedAt.slice(0, 10) ?? 'STANDBY';

function fmtSessions(n: number | undefined): string {
  if (n === undefined) return '--';
  return n >= 1000 ? `${(n / 1000).toFixed(1)}k` : String(n);
}
---

<BaseLayout
  title="ARENA // 开发选型 — 代码 + 智能体"
  description="开发视图：WebDev 代码能力榜 + Agent 干活能力榜并排，含 API 价格，模型选型工作台"
>
  <header class="hud-bar" role="status">
    <span class="hud-bar__status">DEV_MODE // 选型工作台</span>
    <span>WEBDEV: {webdev?.rows.length ?? 0} 模型</span>
    <span>AGENT: {agent?.rows.length ?? 0} 模型</span>
    <span>SNAPSHOT: {lastSync}</span>
    <span>SOURCE: LMArena</span>
  </header>

  <nav class="view-tabs mono" aria-label="榜单视图切换">
    <a href={internalHref('/arena/')} aria-current="page">[ 开发 · 代码+智能体 ]</a>
    <a href={internalHref('/arena/models/')}>[ 模型 · 全能力 ]</a>
    <a href={internalHref('/arena/agent/')}>[ Agent 深度 ]</a>
  </nav>

  <section aria-labelledby="dev-heading">
    <h1 class="section-title" id="dev-heading">开发选型 // 写代码 × 干活</h1>

    <div class="dev-boards">
      {
        webdev && webdev.rows.length > 0 && (
          <div class="board">
            <h2 class="board__title mono">
              Code · WebDev
              <span class="board__meta">{webdev.rows.length} 模型 · Elo</span>
            </h2>
            <ol class="board__list">
              {webdev.rows.slice(0, MAX_ROWS).map((row) => (
                <li class="wrow">
                  <span class="wrow__rank mono">{String(row.rank).padStart(2, '0')}</span>
                  <span class="wrow__model">
                    <span class="wrow__name">{row.modelName}</span>
                    <span class="board__badges">
                      {row.isOpenSource ? <span class="chip chip--open">开源</span> : <span class="chip">闭源</span>}
                      <span class="chip chip--org">{row.organization}</span>
                    </span>
                  </span>
                  <span class="wrow__score mono">
                    {row.score}
                    {row.ci && <span class="wrow__ci"> {row.ci}</span>}
                  </span>
                  <span class="wrow__price mono" title="API 价格 输入/输出 $/M tokens">{row.price ?? '--'}</span>
                </li>
              ))}
            </ol>
          </div>
        )
      }

      {
        agent && agent.rows.length > 0 && (
          <div class="board">
            <h2 class="board__title mono">
              Agent · 能力
              <span class="board__meta">{agent.rows.length} 模型 · 多指标</span>
            </h2>
            <ol class="board__list">
              {agent.rows.slice(0, MAX_ROWS).map((row) => (
                <li class="wrow">
                  <span class="wrow__rank mono">{String(row.rank).padStart(2, '0')}</span>
                  <span class="wrow__model">
                    <span class="wrow__name">{row.modelName}</span>
                    <span class="board__badges">
                      {row.isOpenSource ? <span class="chip chip--open">开源</span> : <span class="chip">闭源</span>}
                      <span class="chip chip--org">{row.organization}</span>
                    </span>
                  </span>
                  <span class="wrow__score mono">
                    {row.netImprovement !== undefined ? `${row.netImprovement.toFixed(1)}%` : '--'}
                    {row.netImprovementCi && <span class="wrow__ci"> {row.netImprovementCi}</span>}
                  </span>
                  <span class="wrow__price mono" title="每任务成本">{row.costPerTask ?? '--'}</span>
                </li>
              ))}
            </ol>
          </div>
        )
      }
    </div>
  </section>

  <p class="note mono">
    // 左榜：前端/Web 开发盲测 Elo（右列 = API 价格 输入/输出 $/M tokens）。
    右榜：真实终端会话多指标（右列 = 每任务成本）。开工选型：能力 × 成本一起看。
    Agent 完整指标见 <a href={internalHref('/arena/agent/')}>Agent 深度视图</a>。
  </p>
</BaseLayout>

<style>
  .view-tabs {
    display: flex;
    gap: var(--space-m);
    padding: var(--space-m) 0;
    font-size: 0.75rem;
    flex-wrap: wrap;
  }

  .view-tabs a {
    color: var(--color-text-dim);
  }

  .view-tabs a:hover,
  .view-tabs a[aria-current='page'] {
    color: var(--color-primary);
  }

  .dev-boards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24rem, 1fr));
    gap: var(--space-l);
  }

  .board__title {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--color-primary);
    margin: 0 0 var(--space-s);
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-s);
  }

  .board__meta {
    font-size: 0.65rem;
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
  }

  .board__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: 2px;
    background: var(--color-surface);
    overflow: hidden;
  }

  .wrow {
    display: grid;
    grid-template-columns: 2.2rem minmax(0, 1fr) 5rem 5.5rem;
    align-items: center;
    gap: var(--space-s);
    padding: 0.45rem var(--space-m);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--duration-fast) ease;
  }

  .wrow:last-child {
    border-bottom: none;
  }

  .wrow:hover {
    background: var(--color-surface-raised);
  }

  .board__list > .wrow:nth-child(-n + 3) .wrow__rank {
    color: var(--color-accent);
    font-weight: 700;
  }

  .wrow__rank {
    font-size: 0.75rem;
    color: var(--color-text-faint);
  }

  .wrow__model {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .wrow__name {
    font-size: 0.85rem;
    font-weight: 500;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .board__badges {
    display: flex;
    gap: var(--space-xs);
    flex-wrap: wrap;
  }

  .chip {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    padding: 0 0.35em;
    border: 1px solid var(--color-border-active);
    border-radius: 2px;
    color: var(--color-text-faint);
    line-height: 1.5;
  }

  .chip--open {
    color: var(--color-primary);
    border-color: var(--color-primary-dim);
  }

  .chip--org {
    color: var(--color-text-dim);
  }

  .wrow__score {
    font-size: 0.9rem;
    font-weight: 600;
    text-align: right;
  }

  .wrow__ci {
    font-size: 0.6rem;
    color: var(--color-text-faint);
    font-weight: 400;
  }

  .wrow__price {
    font-size: 0.65rem;
    color: var(--color-text-faint);
    text-align: right;
  }

  .note {
    margin-top: var(--space-l);
    font-size: 0.7rem;
    color: var(--color-text-faint);
    letter-spacing: 0.05em;
    line-height: 1.8;
  }
</style>
