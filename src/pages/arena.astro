---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArenaBoardPane from '../components/ArenaBoardPane.astro';
import AgentBoardPane from '../components/AgentBoardPane.astro';
import { loadArenaData } from '../lib/site';
import { internalHref } from '../lib/href';
import { ARENA_FILTERS } from '../lib/arena-filters';

const data = loadArenaData();

// 本页 = 🏆 综合维度（其余维度各自独立路径页）
const board = data.boards.find((b) => b.id === 'webdev');
const agent = data.boards.find((b) => b.id === 'agent');
const lastSync = agent?.fetchedAt.slice(0, 10) ?? data.boards[0]?.fetchedAt.slice(0, 10) ?? 'STANDBY';
---

<BaseLayout
  title="ARENA // 开发选型 — 代码 + 智能体"
  description="开发选型工作台：WebDev 五维代码榜（综合/全栈/前端/HTML/React）+ Agent 能力榜，含 API 价格"
>
  <header class="hud-bar" role="status">
    <span class="hud-bar__status">DEV_MODE // 选型工作台</span>
    <span>CODE: {data.boards.filter((b) => b.id.startsWith('webdev')).length} 维</span>
    <span>AGENT: {agent?.rows.length ?? 0} 模型</span>
    <span>SNAPSHOT: {lastSync}</span>
    <span>SOURCE: LMArena</span>
  </header>

  <section aria-labelledby="dev-heading">
    <h1 class="section-title" id="dev-heading">开发选型 // 写代码 × 干活</h1>

    <!-- 筛选条独占一行（两榜列结构完全同构起头对齐） -->
    <nav class="filter-tabs mono" aria-label="WebDev 维度筛选">
      {
        ARENA_FILTERS.map((f) => (
          <a
            href={f.slug === '' ? internalHref('/arena/') : internalHref(`/arena/${f.slug}/`)}
            aria-current={f.slug === '' ? 'page' : undefined}
          >
            {f.label}
          </a>
        ))
      }
    </nav>

    <div class="dev-boards">
      <div class="board">
        <ArenaBoardPane board={board} />
      </div>
      <div class="board">
        <AgentBoardPane board={agent} />
      </div>
    </div>
  </section>

  <p class="note mono">
    // 左列五维均可切换：综合 / 全栈 / 前端 / HTML / React（各维度独立 Elo 榜）。
    右列 = Agent 真实终端多指标（净改进率 + 每任务成本），常驻不切换。
    开工选型：能力 × 成本一起看。
  </p>
</BaseLayout>
