---
import '../styles/global.css';
import { internalHref } from '../lib/href';

interface Props {
  title: string;
  description?: string;
}

const { title, description = '每日 AI 要闻终端 // 信息降噪中' } = Astro.props;
const SITE_URL = 'https://yyy588.github.io/ai-daily-terminal/';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e7a6c" />
    <link rel="icon" type="image/svg+xml" href={internalHref('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title="AI_DAILY_TERMINAL RSS" href={internalHref('rss.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI_DAILY_TERMINAL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={SITE_URL} />
    <meta property="og:image" content={`${SITE_URL}og-card.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body>
    <div class="layout">
      <nav class="nav" aria-label="主导航">
        <a href={internalHref('/')}>终端</a>
        <a href={internalHref('/news/')}>要闻</a>
        <a href={internalHref('/repos/')}>新锐榜</a>
        <a href={internalHref('/arena/')}>模型选型</a>
      </nav>
      <slot />
      <footer class="footer">
        LINK_STABLE // AI DAILY TERMINAL v0.3 // 数据源：量子位 + 爱范儿 + IT之家（RSS）+ GitHub Search API
      </footer>
    </div>
  </body>
</html>
